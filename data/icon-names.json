{
  "_meta": {
    "description": "Semantic icon name manifest for rnw-components. Every component icon literal must use a name from this manifest. Each host adapter maps the semantic name to a vendor-specific glyph.",
    "version": "1.0.0"
  },
  "icons": {
    "calendar":          { "carbon": "calendar",             "ionicons": "calendar" },
    "checkmark":         { "aliases": ["check"], "carbon": "checkmark",       "ionicons": "checkmark" },
    "chevron_down":      { "aliases": ["chevron--down", "chevron-down"], "carbon": "chevronDown",   "ionicons": "chevronDown" },
    "chevron_up":        { "aliases": ["chevron--up", "chevron-up"], "carbon": "chevronUp",     "ionicons": "chevronUp" },
    "chevron_right":     { "aliases": ["chevron--right", "chevron-right"], "carbon": "chevronRight", "ionicons": "chevronForward" },
    "close":             { "carbon": "close",                 "ionicons": "close" },
    "copy":              { "carbon": "copy",                  "ionicons": "copy" },
    "eye":               { "carbon": "view",                  "ionicons": "eye" },
    "eye_off":           { "aliases": ["eye-off"], "carbon": "viewOff",              "ionicons": "eyeOff" },
    "info":              { "aliases": ["information"], "carbon": "information",         "ionicons": "information" },
    "overflow":          { "carbon": "overflowMenuHorizontal", "ionicons": "ellipsisHorizontal" },
    "search":            { "carbon": "search",               "ionicons": "search" },
    "time":              { "carbon": "time",                 "ionicons": "time" },
    "warning":           { "carbon": "warning",              "ionicons": "warning" },
    "error":             { "carbon": "warningFilled",        "ionicons": "alertCircle" },
    "success":           { "carbon": "checkmarkFilled",      "ionicons": "checkmarkCircle" },
    "loading":           { "carbon": "restart",              "ionicons": "sync" },
    "visibility":        { "carbon": "view",                  "ionicons": "eye" },
    "visibility_off":    { "carbon": "viewOff",               "ionicons": "eyeOff" },
    "home":              { "carbon": "home",                  "ionicons": "homeOutline" },
    "user":              { "aliases": ["person"], "carbon": "user",           "ionicons": "personOutline" },
    "trash":             { "carbon": "trashCan",              "ionicons": "trashOutline" },
    "add":               { "carbon": "add",                   "ionicons": "add" },
    "favorite":          { "aliases": ["heart"], "carbon": "favorite",        "ionicons": "heart" },
    "settings":          { "carbon": "settings",              "ionicons": "settingsOutline" },
    "menu":              { "carbon": "menu",                  "ionicons": "menuOutline" },
    "notification":      { "carbon": "notification",          "ionicons": "notificationsOutline" },
    "share":             { "carbon": "share",                 "ionicons": "shareOutline" },
    "download":          { "carbon": "download",              "ionicons": "downloadOutline" },
    "edit":              { "carbon": "edit",                  "ionicons": "createOutline" },
    "checkmark_filled":  { "carbon": "checkmarkFilled",       "ionicons": "checkmarkCircle" },
    "information_filled": { "carbon": "informationFilled",    "ionicons": "informationCircle" },
    "warning_filled":    { "carbon": "warningFilled",         "ionicons": "alertCircle" },
    "document":          { "carbon": "document",              "ionicons": "documentTextOutline" },
    "checkbox":          { "carbon": "checkboxChecked",       "ionicons": "checkboxOutline" },
    "checkbox_unchecked": { "carbon": "checkbox",             "ionicons": "squareOutline" },
    "tools":             { "carbon": "tools",                 "ionicons": "buildOutline" },
    "accessibility":     { "carbon": "accessibility",         "ionicons": "accessibilityOutline" },
    "task_complete":     { "carbon": "taskComplete",          "ionicons": "checkmarkDoneOutline" },
    "group":             { "carbon": "group",                 "ionicons": "peopleOutline" },
    "grid":              { "carbon": "grid",                  "ionicons": "gridOutline" },
    "layers":            { "carbon": "layers",                "ionicons": "layersOutline" },
    "cube":              { "carbon": "cube",                  "ionicons": "cubeOutline" }
  }
}
