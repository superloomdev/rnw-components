{
  "name": "@superloomdev/rnw-components",
  "description": "Superloom standard component system for React Native Web",
  "version": "1.0.0",
  "author": {
    "name": "sj00"
  },
  "contributors": [],
  "private": false,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./components.js",
    "./all": "./all.js",
    "./data/style-contract.json": "./data/style-contract.json",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "node scripts/verify.js",
    "verify:gates": "node scripts/verify.js --gates",
    "verify:full": "node scripts/verify.js --full",
    "verify:parity": "cd _test && node --import ./harness/register.js --test parity.test.js"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.86.0",
    "react-native-web": ">=0.21.0",
    "helper-utils": "npm:@superloomdev/js-helper-utils@^1.0.0",
    "helper-debug": "npm:@superloomdev/js-helper-debug@^1.0.0",
    "helper-themer": "npm:@superloomdev/js-client-helper-themer@^1.0.0",
    "helper-device": "npm:@superloomdev/js-rnw-helper-device@^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.0",
    "@superloomdev/js-helper-eslint-config": "^1.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
