# Note: README.md, ROBOTS.md, and docs/ are intentionally NOT excluded.
# The npm registry renders README.md on the package page and README.md links
# to docs/ and ROBOTS.md - excluding them would break those links for consumers.

# Engineering decision journal (internal contributor notes, not for package consumers)
THOUGHTS.md

# Test infrastructure (repo root, not part of the package)
_test/

# Linter config (dev only)
eslint.config.js

# Dev tooling scripts (local verification, not part of the package)
scripts/

# CI parity artifacts (local verification, not part of the package)
.ci-step-map.tsv
.ci-unreplicable.tsv
.githooks/
.verify-stamp

# Devin workflow definitions (internal tooling, not for package consumers)
.devin/

# CI / GitHub (includes ci-scripts/)
.github/

# Git
.git/
.gitignore

# License lives at repo root but npm includes it automatically
LICENSE

# Dependencies
node_modules/
package-lock.json

# OS files
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# npm cache
.npm
