{
  "name": "@superloomdev/rnw-components-test",
  "description": "Unit tests for rnw-components",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import ./harness/register.js --test test.js audit.test.js contract.test.js system.test.js theme.test.js parity.test.js spec.test.js assertion-integrity.test.js icon-fidelity.test.js geometry-lint.test.js",
    "test:parity": "node --import ./harness/register.js --test parity.test.js",
    "test:l3": "npx esbuild visual/entry.js --bundle --format=esm --outfile=visual/bundle.js --platform=browser --alias:node:module=./harness/node-module-stub.js --alias:react-native=react-native-web --define:process.env.NODE_ENV=\\\"development\\\" && npx playwright test interact.test.js",
    "test:treeshake": "node --test treeshake.test.js",
    "fire": "bash fire.sh"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "@vitejs/plugin-react": "^4.3.0",
    "axe-core": "^4.10.3",
    "helper-debug": "npm:@superloomdev/js-helper-debug@^1.0.0",
    "helper-device": "npm:@superloomdev/js-rnw-helper-device@^1.0.0",
    "helper-themer": "npm:@superloomdev/js-client-helper-themer@^1.0.0",
    "helper-themer-template-carbon": "npm:@superloomdev/js-client-helper-themer-template-carbon@^1.0.0",
    "helper-utils": "npm:@superloomdev/js-helper-utils@^1.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-native-web": "^0.21.2",
    "react-test-renderer": "^19.2.0",
    "rnw-components": "file:../",
    "vite": "^6.4.0"
  },
  "devDependencies": {
    "@carbon/react": "1.115.0",
    "@carbon/styles": "1.115.0",
    "@material/web": "^2.5.0"
  }
}
